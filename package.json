{
  "name": "vscode-ollama-agent",
  "version": "0.0.1",
  "description": "Independent AI agenting extension for VS Code Insiders — works like GitHub Copilot with local Ollama",
  "keywords": [
    "ollama",
    "ai",
    "agent",
    "completion",
    "code-generation",
    "local-llm"
  ],
  "homepage": "https://github.com/masumipe/vscode_agent#readme",
  "bugs": {
    "url": "https://github.com/masumipe/vscode_agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumipe/vscode_agent.git"
  },
  "license": "ISC",
  "author": "Rashed",
  "type": "commonjs",
  "main": "./out/extension.js",
  "types": "./out/extension.d.ts",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require ts-node/register --reporter spec tests/unit/**/*.ts",
    "test:integration": "mocha --reporter spec tests/integration/**/*.ts"
  },
  "dependencies": {
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "18.x",
    "@types/vscode": "1.85.x",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "glob": "^8.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "displayName": "Ollama Agent",
  "publisher": "yourname",
  "categories": [
    "AI",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartup",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:rust"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ollama.agent.create",
        "title": "Ollama: Create New Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.agent.run",
        "title": "Ollama: Run Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.agent.evaluate",
        "title": "Ollama: Evaluate Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.agent.debug",
        "title": "Ollama: Debug Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.acceptCompletion",
        "title": "Ollama: Accept Completion",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.agent.status",
        "title": "Ollama: Toggle Status",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.chat",
        "title": "Ollama: Open AI Assistant",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.generateCode",
        "title": "Ollama: Generate Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.debugCode",
        "title": "Ollama: Debug Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.explainCode",
        "title": "Ollama: Explain Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.refactor",
        "title": "Ollama: Refactor Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.writeTests",
        "title": "Ollama: Write Tests",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.generateDocs",
        "title": "Ollama: Generate Documentation",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.newAgent",
        "title": "Ollama: New Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.chat.send",
        "title": "Ollama: Send Message",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.chat.closePanel",
        "title": "Ollama: Close Chat Panel",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.ask",
        "title": "AI Agent: Ask Agent",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.readEditor",
        "title": "AI Agent: Read Editor",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.readFile",
        "title": "AI Agent: Read File",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.writeFile",
        "title": "AI Agent: Write File",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.deleteFile",
        "title": "AI Agent: Delete File",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.insertCode",
        "title": "AI Agent: Insert Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.runCode",
        "title": "AI Agent: Run Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.testCode",
        "title": "AI Agent: Test Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.debugCode",
        "title": "AI Agent: Debug Code",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.browseWeb",
        "title": "AI Agent: Browse Web",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.executeCommand",
        "title": "AI Agent: Execute Command",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.copilot.status",
        "title": "AI Agent: Show Status",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.changes.accept",
        "title": "Ollama: Accept Changes",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.changes.reject",
        "title": "Ollama: Reject Changes",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.changes.acceptAll",
        "title": "Ollama: Accept All Changes",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.changes.rejectAll",
        "title": "Ollama: Reject All Changes",
        "category": "Ollama Agent"
      },
      {
        "command": "ollama.changes.show",
        "title": "Ollama: Review Pending Changes",
        "category": "Ollama Agent"
      }
    ],
    "menus": {
      "view/title": [],
      "commandPalette": [
        {
          "command": "ollama.changes.accept",
          "when": "ollama.hasPendingChanges"
        },
        {
          "command": "ollama.changes.reject",
          "when": "ollama.hasPendingChanges"
        },
        {
          "command": "ollama.changes.show",
          "when": "ollama.hasPendingChanges"
        },
        {
          "command": "ollama.chat",
          "title": "Ollama: Open AI Assistant"
        },
        {
          "command": "ollama.generateCode",
          "title": "Ollama: Generate Code"
        },
        {
          "command": "ollama.debugCode",
          "title": "Ollama: Debug Code"
        },
        {
          "command": "ollama.explainCode",
          "title": "Ollama: Explain Code"
        },
        {
          "command": "ollama.refactor",
          "title": "Ollama: Refactor Code"
        },
        {
          "command": "ollama.writeTests",
          "title": "Ollama: Write Tests"
        },
        {
          "command": "ollama.generateDocs",
          "title": "Ollama: Generate Documentation"
        },
        {
          "command": "ollama.newAgent",
          "title": "Ollama: New Agent"
        },
        {
          "command": "ollama.agent.run",
          "title": "Ollama: Run Agent"
        },
        {
          "command": "ollama.agent.evaluate",
          "title": "Ollama: Evaluate Agent"
        },
        {
          "command": "ollama.agent.debug",
          "title": "Ollama: Debug Agent"
        }
      ],
      "explorer/newFile": [
        {
          "command": "ollama.agent.create",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Ollama Agent",
      "properties": {
        "ollama.serverUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },
        "ollama.defaultModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Default model to use for agents"
        },
        "ollama.enableTracing": {
          "type": "boolean",
          "default": true,
          "description": "Enable agent tracing and logging"
        },
        "ollama.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens for agent responses"
        },
        "ollama.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered code completion"
        },
        "ollama.completionDelay": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds before showing completions"
        },
        "ollama.completionLimit": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of completion suggestions"
        },
        "ollama.autonomous.readEditor": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to read from editor"
        },
        "ollama.autonomous.readTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to read from terminal"
        },
        "ollama.autonomous.readFolder": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to read from folder"
        },
        "ollama.autonomous.writeFile": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to write files"
        },
        "ollama.autonomous.deleteFile": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to delete files"
        },
        "ollama.autonomous.insertCode": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to insert code"
        },
        "ollama.autonomous.runCode": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to run code"
        },
        "ollama.autonomous.testCode": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to test code"
        },
        "ollama.autonomous.debugCode": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to debug code"
        },
        "ollama.autonomous.browseWeb": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to browse web"
        },
        "ollama.autonomous.executeCommand": {
          "type": "boolean",
          "default": false,
          "description": "Allow autonomous agent to execute commands"
        },
        "ollama.copilot.readEditor": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to read from editor"
        },
        "ollama.copilot.readTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to read from terminal"
        },
        "ollama.copilot.readFolder": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to read from folder"
        },
        "ollama.copilot.writeFile": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to write files"
        },
        "ollama.copilot.deleteFile": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to delete files"
        },
        "ollama.copilot.insertCode": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to insert code"
        },
        "ollama.copilot.runCode": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to run code"
        },
        "ollama.copilot.testCode": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to test code"
        },
        "ollama.copilot.debugCode": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to debug code"
        },
        "ollama.copilot.browseWeb": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to browse web"
        },
        "ollama.copilot.executeCommand": {
          "type": "boolean",
          "default": true,
          "description": "Allow AI agent to execute commands"
        }
      }
    }
  },
  "viewsContainers": {
    "activityBar": [
      {
        "id": "ollama-views",
        "title": "Ollama Agent",
        "icon": "$(ai-chat)"
      }
    ]
  },
  "views": {
    "ollama-views": [
      {
        "id": "ollama-agents",
        "name": "Agents",
        "icon": "$(agent)"
      },
      {
        "id": "ollama-traces",
        "name": "Traces",
        "icon": "$(debug-console)"
      }
    ]
  },
  "viewContainers": {},
  "viewsWelcome": [
    {
      "id": "ollama-agents-welcome",
      "viewId": "ollama-agents",
      "contents": "No agents found. Click 'Create New Agent' to get started."
    }
  ],
  "jsonValidation": [
    {
      "fileMatch": [
        "agent.yaml",
        "agent.json"
      ],
      "url": "https://raw.githubusercontent.com/microsoft/ai-lab/main/schemas/agent.schema.json"
    }
  ]
}
